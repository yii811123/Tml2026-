                          >
                            <span className="text-[11px]">{lm.icon}</span>
                            <span className="text-[10px] font-black text-white whitespace-nowrap">{getLmCode(lm)}</span>
                            {count > 0 && (
                              <span className="text-[9px] font-black px-1.5 rounded-full bg-cyan-400 text-slate-950">
                                {count}人
                              </span>
                            )}
                          </button>

                          {people.length > 0 && (
                            <div className="mt-1 flex flex-wrap justify-center gap-1 bg-slate-950/85 backdrop-blur-md p-1 rounded-xl border border-white/15 shadow-xl">
                              {people.map(p => {
                                const isMe = p.name === myProfile.name;
                                return (
                                  <button
                                    key={p.id}
                                    onClick={e => {
                                      e.stopPropagation();
                                      setActiveMapPinId(p.id);
                                    }}
                                    className={`px-1.5 py-0.5 rounded-lg text-[10px] font-extrabold flex items-center gap-0.5 ${
                                      isMe ? 'bg-cyan-400 text-slate-950 ring-2 ring-white font-black' : 'bg-slate-800 text-white border border-slate-600'
                                    }`}
                                  >
                                    <span className="truncate max-w-[52px]">{p.name}</span>
                                    {(p.partySize || 1) > 1 && <span className="text-[8px] text-amber-300 font-black">+{p.partySize - 1}</span>}
                                  </button>
                                );
                              })}
                            </div>
                          )}
                        </div>
                      );
                    })}

                    {/* 手機 GPS 精準定位或手點地圖的獨立動態大頭針 */}
                    {checkins
                      .filter(c => c.isCustomPin)
                      .map(p => {
                        const isMe = p.name === myProfile.name;
                        return (
                          <button
                            key={p.id}
                            style={{ left: `${p.mapX}%`, top: `${p.mapY}%` }}
                            onClick={e => {
                              e.stopPropagation();
                              setActiveMapPinId(p.id);
                            }}
                            className="absolute -translate-x-1/2 -translate-y-full z-30 flex flex-col items-center"
                          >
                            <div className={`px-2 py-0.5 rounded-full border shadow-xl flex items-center gap-1 text-[10px] font-extrabold whitespace-nowrap ${
                              isMe ? 'bg-cyan-400 text-slate-950 border-white font-black' : 'bg-slate-900 text-white border-cyan-400'
                            }`}>
                              <span>🛰️ {p.name}</span>
                              {(p.partySize || 1) > 1 && <span>+{p.partySize - 1}</span>}
                            </div>
                            <div className="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-cyan-400" />
                          </button>
                        );
                      })}
                  </div>

                  {/* 點擊團員名牌後的底部狀態條 */}
                  {(() => {
                    const p = checkins.find(c => c.id === activeMapPinId) || checkins[0];
                    if (!p) {
                      return (
                        <div className="p-2.5 bg-slate-950 border-t border-slate-800 text-center text-[11px] text-slate-400">
                          {t('目前還沒有人打卡，快在下方點選【A點～F點】成為第一個測試者！', 'No check-ins yet. Tap Point A~F below to check in!')}
                        </div>
                      );
                    }
                    const lm = LANDMARKS.find(l => l.id === p.landmarkId) || LANDMARKS[0];
                    return (
                      <div className="p-2.5 bg-slate-950 border-t border-slate-800 flex items-center justify-between gap-2">
                        <div className="min-w-0 space-y-0.5">
                          <div className="flex items-center gap-1.5 flex-wrap">
                            <span className="text-xs font-black text-cyan-300">📍 {p.name}</span>
                            {(p.partySize || 1) > 1 && (
                              <span className="text-[10px] font-bold px-1.5 rounded bg-amber-500/20 text-amber-300">
                                +{p.partySize - 1}人
                              </span>
                            )}
                            <span className="text-[10px] font-bold bg-slate-800 text-white px-1.5 py-0.5 rounded">
                              {getLmCode(lm)} {getLmName(lm)}
                            </span>
                            {p.watchingDj && (
                              <span className="text-[10px] font-extrabold bg-purple-500/25 text-purple-200 border border-purple-500/40 px-1.5 py-0.5 rounded">
                                🎧 {p.watchingDj}
                              </span>
                            )}
                            <span className="text-[10px] text-emerald-400 font-mono">
                              🕒 {formatExactTime(p.updatedAt)} ({formatTimeAgo(p.updatedAt)})
                            </span>
                          </div>
                          <p className="text-[11px] text-slate-300 truncate">💬 {p.note}</p>
                        </div>
                        <a
                          href={`https://www.google.com/maps?q=${p.lat || lm.lat},${p.lng || lm.lng}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="shrink-0 px-2.5 py-1.5 rounded-xl bg-slate-800 text-cyan-300 border border-cyan-500/30 text-[11px] font-bold"
                        >
                          導航 ↗
                        </a>
                      </div>
                    );
                  })()}
                </section>

                {/* ==========================================
                    📍 二合一快速打卡面板 (地點 + 自動連動【NOW + 下2個時段 DJ】)
                ========================================== */}
                <section className="p-3.5 rounded-3xl bg-slate-900/95 border border-cyan-500/30 space-y-3">
                  <div className="flex items-center justify-between">
                    <h2 className="text-xs font-black text-cyan-300">
                      📍 {t('一鍵定位打卡（地點 ＋ 時刻表連動）', '1-Tap Check-In (Live Timetable)')}
                    </h2>
                    <div className="flex gap-1">
                      <button
                        onClick={() => copyLineText('me')}
                        className="px-2 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-bold"
                      >
                        📋 {t('複製我的位置', 'Copy Mine')}
                      </button>
                      <button
                        onClick={() => copyLineText('all')}
                        className="px-2 py-1 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-[10px] font-bold"
                      >
                        📢 {t('複製全團名單', 'Copy All')}
                      </button>
                    </div>
                  </div>

                  {/* 第一步：點選 A~F 點 + SOS */}
                  <div className="grid grid-cols-4 sm:grid-cols-7 gap-1.5">
                    {LANDMARKS.map(lm => {
                      const isSel = selectedLandmark === lm.id;
                      return (
                        <button
                          key={lm.id}
                          onClick={() => {
                            setSelectedLandmark(lm.id);
                            setWatchingDj('');
                          }}
                          className={`p-2 rounded-xl border text-center transition ${
                            lm.id === 'SOS'
                              ? isSel ? 'bg-red-600 text-white border-white' : 'bg-red-950/50 border-red-500/40 text-red-300'
                              : isSel ? 'bg-cyan-500/25 border-cyan-400 ring-1 ring-cyan-400' : 'bg-slate-950 border-slate-800'
                          }`}
                        >
                          <div className="text-xs font-black">{lm.icon} {getLmCode(lm)}</div>
                          <div className="text-[9px] text-slate-400 truncate mt-0.5">{lm.stage}</div>
                        </button>
                      );
                    })}
                  </div>

                  {/* 第二步：若選到舞台 (A點 Main Stage 或 B點 RESISTANCE)，自動顯示【NOW + NEXT 1 + NEXT 2】 */}
                  {stageSlots.length > 0 ? (
                    <div className="space-y-1.5">
                      <div className="text-[11px] text-slate-300 flex items-center justify-between">
                        <span>🎧 {t(`【${currentLmObj.code} ${currentLmObj.stage}】現在與接下來 2 場 DJ：`, `[${currentLmObj.stage}] Now & Next 2 Sets:`)}</span>
                      </div>
                      <div className="grid grid-cols-1 sm:grid-cols-3 gap-1.5">
                        {stageSlots.map(slot => {
                          const labelStr = `${slot.dj} (${slot.start})`;
                          const isSelectedDj = watchingDj === labelStr;
                          return (
                            <button
                              key={slot.dj}
                              type="button"
                              onClick={() => setWatchingDj(isSelectedDj ? '' : labelStr)}
                              className={`p-2 rounded-xl border text-left transition flex flex-col justify-between ${
                                isSelectedDj
                                  ? 'bg-purple-600/40 border-purple-300 ring-1 ring-purple-300'
                                  : slot.isNow
                                  ? 'bg-slate-950 border-rose-500/50'
                                  : 'bg-slate-950 border-slate-800'
                              }`}
                            >
                              <div className="flex items-center justify-between gap-1">
                                <span className={`text-[9px] font-black px-1.5 py-0.2 rounded ${
                                  slot.isNow ? 'bg-rose-500 text-white animate-pulse' : 'bg-slate-800 text-cyan-300'
                                }`}>
                                  {slot.isNow ? '🔴 NOW' : `⏭️ ${slot.tag}`}
                                </span>
                                <span className="text-[10px] font-mono text-slate-400">{slot.start}-{slot.end}</span>
                              </div>
                              <div className="text-xs font-black text-white truncate mt-1">
                                {slot.dj}
                              </div>
                            </button>
                          );
                        })}
                      </div>
                    </div>
                  ) : (
                    /* 若選到非舞台區 (C~F點)，顯示快速狀態標籤 */
                    <div className="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
                      {(currentLmObj.quickStatus || []).map(st => (
                        <button
                          key={st}
                          type="button"
                          onClick={() => setWatchingDj(watchingDj === st ? '' : st)}
                          className={`px-2.5 py-1 rounded-full text-[11px] font-bold whitespace-nowrap border ${
                            watchingDj === st ? 'bg-cyan-500 text-slate-950 border-white' : 'bg-slate-950 text-slate-300 border-slate-800'
                          }`}
                        >
                          ✨ {st}
                        </button>
                      ))}
                    </div>
                  )}

                  {/* 第三步：備註 + 立即打卡按鈕 */}
                  <div className="flex gap-2">
                    <input
                      type="text"
                      value={statusNote}
                      onChange={e => setStatusNote(e.target.value)}
                      placeholder={t('補充備註（例：穿黑色背心、在酒吧右側）...', 'Optional note...')}
                      className="flex-1 px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white"
                    />
                    <button
                      onClick={() => handleCheckIn(selectedLandmark)}
                      className="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 font-black text-xs shrink-0 shadow-lg active:scale-95"
                    >
                      📍 {t(`打卡 ${currentLmObj.code}`, `Pin ${currentLmObj.codeEn}`)}
                    </button>
                  </div>
                </section>
              </div>
            )}

            {/* ==========================================
                TAB 2: 👥 找隊友 & 時間軸 (連點標題 5 下開啟團長重置)
            ========================================== */}
            {activeTab === 'friends' && (
              <div className="space-y-3">
                <div className="p-3.5 rounded-3xl bg-slate-900 border border-slate-800 space-y-2.5">
                  <div className="flex items-center justify-between gap-2">
                    <span
                      onClick={() => {
                        const next = adminTapCount + 1;
                        if (next >= 5) {
                          setShowAdminModal(true);
                          setAdminTapCount(0);
                        } else {
                          setAdminTapCount(next);
                        }
                      }}
                      className="text-xs font-extrabold text-cyan-300 cursor-pointer"
                    >
                      👥 {t(`全團即時動態 (${totalHeadcount}人)`, `Live Squad (${totalHeadcount})`)}
                    </span>
                    {checkins.some(c => c.name === myProfile.name) && (
                      <button
                        onClick={handleRemoveMyCheckin}
                        className="text-[11px] text-rose-400 hover:underline font-bold"
                      >
                        👋 {t('移除我的定位', 'Clear My Pin')}
                      </button>
                    )}
                  </div>

                  <input
                    type="text"
                    value={searchQuery}
                    onChange={e => setSearchQuery(e.target.value)}
                    placeholder={t('🔍 搜尋朋友名字、A~F點或正在看的 DJ...', '🔍 Search friend name, Point A~F, or DJ...')}
                    className="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white"
                  />

                  {checkins.length === 0 ? (
                    <div className="py-10 text-center text-xs text-slate-500">
                      {t('目前還沒有人打卡喔！快去「定位地圖」按第一個打卡測試看看！', 'No check-ins yet!')}
                    </div>
                  ) : (
                    <div className="space-y-2">
                      {checkins
                        .filter(c => {
                          if (!searchQuery.trim()) return true;
                          const q = searchQuery.toLowerCase();
                          return (
                            c.name.toLowerCase().includes(q) ||
                            (c.watchingDj || '').toLowerCase().includes(q) ||
                            (c.note || '').toLowerCase().includes(q) ||
                            c.landmarkId.toLowerCase().includes(q)
                          );
                        })
                        .sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0))
                        .map(p => {
                          const lm = LANDMARKS.find(l => l.id === p.landmarkId) || LANDMARKS[0];
                          return (
                            <div key={p.id} className="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-2">
                              <div className="space-y-1 min-w-0">
                                <div className="flex items-center gap-1.5 flex-wrap">
                                  <span className="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">
                                    {formatExactTime(p.updatedAt)}
                                  </span>
                                  <span className="text-xs font-black text-white">{p.name}</span>
                                  {(p.partySize || 1) > 1 && (
                                    <span className="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300">
                                      +{p.partySize - 1}人
                                    </span>
                                  )}
                                  <span className={`text-[10px] font-extrabold px-2 py-0.5 rounded bg-gradient-to-r ${lm.badgeColor} text-white`}>
                                    {lm.icon} {getLmCode(lm)} {getLmName(lm)}
                                  </span>
                                  {p.watchingDj && (
                                    <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-500/20 text-purple-200 border border-purple-500/30">
                                      🎧 {p.watchingDj}
                                    </span>
                                  )}
                                </div>
                                <p className="text-xs text-slate-400 truncate">💬 {p.note}</p>
                              </div>
                              <button
                                onClick={() => {
                                  setActiveMapPinId(p.id);
                                  setActiveTab('map');
                                }}
                                className="shrink-0 px-2.5 py-1.5 rounded-xl bg-slate-900 text-cyan-300 border border-slate-700 text-[11px] font-bold"
                              >
                                看地圖
                              </button>
                            </div>
                          );
                        })}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* ==========================================
                TAB 3: 🕒 11/14 (六) 完整官方時刻表總覽
            ========================================== */}
            {activeTab === 'timetable' && (
              <div className="space-y-3">
                <div className="p-3.5 rounded-3xl bg-slate-900 border border-cyan-500/30 space-y-3">
                  <div className="flex items-center justify-between">
                    <h2 className="text-xs font-black text-cyan-300">⚡ Ultra Taiwan 2026/11/14 (六) 官方時刻表</h2>
                    <a
                      href="https://ultrataiwan.com/"
                      target="_blank"
                      rel="noopener noreferrer"
                      className="text-[11px] text-cyan-400 underline"
                    >
                      官網 ↗
                    </a>
                  </div>

                  {/* Main Stage */}
                  <div className="space-y-1.5">
                    <div className="text-xs font-black text-blue-300 bg-blue-500/15 px-2.5 py-1 rounded-lg border border-blue-500/30">
                      ⚡ ULTRA MAIN STAGE (A點)
                    </div>
                    <div className="grid grid-cols-1 gap-1.5">
                      {ULTRA_TIMETABLE.A.map(slot => (
                        <div key={slot.dj} className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs">
                          <span className="font-mono text-cyan-300 font-bold">{slot.start} - {slot.end}</span>
                          <span className="font-black text-white">{slot.dj}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* RESISTANCE Stage */}
                  <div className="space-y-1.5 pt-2">
                    <div className="text-xs font-black text-purple-300 bg-purple-500/15 px-2.5 py-1 rounded-lg border border-purple-500/30">
                      🕷️ RESISTANCE STAGE (B點)
                    </div>
                    <div className="grid grid-cols-1 gap-1.5">
                      {ULTRA_TIMETABLE.B.map(slot => (
                        <div key={slot.dj} className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs">
                          <span className="font-mono text-purple-300 font-bold">{slot.start} - {slot.end}</span>
                          <span className="font-black text-white">{slot.dj}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </main>

          {/* 團長管理員密碼重置彈窗 (連點標題 5 下開啟) */}
          {showAdminModal && (
            <div onClick={() => setShowAdminModal(false)} className="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
              <div onClick={e => e.stopPropagation()} className="w-full max-w-xs rounded-3xl bg-slate-900 border border-rose-500/50 p-5 space-y-3">
                <div className="text-sm font-black text-rose-300">🔐 團長管理員重置</div>
                <p className="text-xs text-slate-400">輸入管理員密碼以清空今日所有人的測試定位紀錄：</p>
                <input
                  type="password"
                  value={adminPassword}
                  onChange={e => setAdminPassword(e.target.value)}
                  placeholder="輸入密碼 (預設 2026)"
                  className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white"
                />
                <div className="flex gap-2">
                  <button onClick={() => setShowAdminModal(false)} className="flex-1 py-2 rounded-xl bg-slate-800 text-xs font-bold">取消</button>
                  <button onClick={handleAdminClearAll} className="flex-1 py-2 rounded-xl bg-rose-600 text-white text-xs font-black">確認清空</button>
                </div>
              </div>
            </div>
          )}

          {/* ==========================================
              底部 3 分頁極簡導覽列
          ========================================== */}
          <nav className="fixed bottom-0 inset-x-0 z-40 bg-[#050814]/95 backdrop-blur-md border-t border-cyan-500/25 px-3 py-1.5">
            <div className="max-w-xl mx-auto grid grid-cols-3 gap-2">
              <button
                onClick={() => setActiveTab('map')}
                className={`py-2 rounded-2xl flex items-center justify-center gap-1.5 text-xs font-extrabold transition ${
                  activeTab === 'map' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40' : 'text-slate-400'
                }`}
              >
                <span>📍</span>
                <span>{t('定位地圖', 'Live Map')}</span>
              </button>
              <button
                onClick={() => setActiveTab('friends')}
                className={`py-2 rounded-2xl flex items-center justify-center gap-1.5 text-xs font-extrabold transition ${
                  activeTab === 'friends' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40' : 'text-slate-400'
                }`}
              >
                <span>👥</span>
                <span>{t(`找隊友 (${totalHeadcount})`, `Squad (${totalHeadcount})`)}</span>
              </button>
              <button
                onClick={() => setActiveTab('timetable')}
                className={`py-2 rounded-2xl flex items-center justify-center gap-1.5 text-xs font-extrabold transition ${
                  activeTab === 'timetable' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40' : 'text-slate-400'
                }`}
              >
                <span>🕒</span>
                <span>{t('11/14 時刻表', 'Set Times')}</span>
              </button>
            </div>
          </nav>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
