<body class="bg-[#050814] text-slate-100 select-none">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo } = React;

    // ==========================================
    // 🔥 專屬雲端即時資料庫網址 (獨立存放在 /ultra_tw_2026 節點，絕不污染年底泰國資料)
    // ==========================================
    const FIREBASE_DB_URL = "https://tml2026-default-rtdb.asia-southeast1.firebasedatabase.app";
    const DB_NODE = "ultra_tw_2026";

    // ==========================================
    // 🎧 Ultra Taiwan 2026/11/14 (六) 官方完整時刻表
    // ==========================================
    const ULTRA_TIMETABLE = {
      A: [
        { start: '13:30', end: '14:30', dj: 'Opening Support' },
        { start: '14:30', end: '15:30', dj: 'Local Guest' },
        { start: '15:30', end: '16:30', dj: 'Levity' },
        { start: '16:30', end: '17:45', dj: '¥ØU$UK€ ¥UK1MAT$U' },
        { start: '17:45', end: '19:00', dj: 'Bunt.' },
        { start: '19:00', end: '20:20', dj: 'Sebastian Ingrosso' },
        { start: '20:25', end: '21:55', dj: 'Alan Walker' }
      ],
      B: [
        { start: '14:00', end: '15:30', dj: 'RESISTANCE Warmup' },
        { start: '15:30', end: '17:00', dj: 'Massano' },
        { start: '17:00', end: '18:30', dj: 'Korolova' },
        { start: '18:30', end: '20:00', dj: 'Chris Avantgarde' },
        { start: '20:00', end: '21:55', dj: 'CamelPhat' }
      ]
    };

    // ==========================================
    // 📍 大佳河濱公園 (Dajia Riverside Park) 官方 Sitemap 精準對位配置 (A~F + SOS)
    // ==========================================
    // 園區真實 GPS 邊界校正（用於將手機真實經緯度精準對應到官方 Sitemap 的 X%, Y% 座標）
    const SITEMAP_GEO_BOUNDS = {
      north: 25.0764, // 北側 PGA / 河岸線
      south: 25.0726, // 南側 Legend / 9號水門外圍
      west:  121.5346, // 西側 Main Stage 左彎道
      east:  121.5408  // 東側 RESISTANCE 右側邊界
    };

    const gpsToSitemapPercent = (lat, lng) => {
      const rawX = ((lng - SITEMAP_GEO_BOUNDS.west) / (SITEMAP_GEO_BOUNDS.east - SITEMAP_GEO_BOUNDS.west)) * 100;
      const rawY = ((SITEMAP_GEO_BOUNDS.north - lat) / (SITEMAP_GEO_BOUNDS.north - SITEMAP_GEO_BOUNDS.south)) * 100;
      return {
        mapX: Math.min(92, Math.max(8, Number(rawX.toFixed(1)))),
        mapY: Math.min(88, Math.max(18, Number(rawY.toFixed(1))))
      };
    };

    const LANDMARKS = [
      {
        id: 'A',
        code: 'A點',
        codeEn: 'Point A',
        name: 'ULTRA MAIN STAGE・主舞台前方',
        nameEn: 'ULTRA MAIN STAGE • Front Lawn',
        stage: 'Main Stage',
        desc: '官方圖左側 ULTRA MAIN STAGE 主舞台前方（緊鄰 VIP / ISLAND / VVIP）',
        descEn: 'Left side of official sitemap at ULTRA MAIN STAGE (by VIP & ISLAND)',
        badgeColor: 'from-cyan-500 to-blue-600',
        borderColor: 'border-cyan-400',
        icon: '⚡',
        mapX: 25,
        mapY: 52,
        lat: 25.0748,
        lng: 121.5359,
        quickStatus: ['主舞台前排開炸', '靠 ISLAND 吧台側邊']
      },
      {
        id: 'B',
        code: 'B點',
        codeEn: 'Point B',
        name: 'RESISTANCE 舞台・右側主場區',
        nameEn: 'RESISTANCE Stage • Right Arena',
        stage: 'RESISTANCE',
        desc: '官方圖右上角 RESISTANCE 舞台前方（緊鄰右側酒吧與醫護站）',
        descEn: 'Upper-right of official sitemap at RESISTANCE Stage',
        badgeColor: 'from-purple-500 to-indigo-600',
        borderColor: 'border-purple-400',
        icon: '🕷️',
        mapX: 83,
        mapY: 38,
        lat: 25.0754,
        lng: 121.5396,
        quickStatus: ['RESISTANCE 舞台前開跳', '右側吧台喝酒']
      },
      {
        id: 'C',
        code: 'C點',
        codeEn: 'Point C',
        name: '北側 PGA 專區＆河岸酒吧',
        nameEn: 'North PGA Area & Bar',
        stage: 'PGA & North Bar',
        desc: '官方圖最上方 PGA 區域、吸菸區與河岸吧台',
        descEn: 'Top north section by PGA Area, Smoking Area & Bar',
        badgeColor: 'from-emerald-500 to-teal-600',
        borderColor: 'border-emerald-400',
        icon: '🥂',
        mapX: 50,
        mapY: 31,
        lat: 25.0758,
        lng: 121.5376,
        quickStatus: ['北側吧台聊天', '在吸菸區休息']
      },
      {
        id: 'D',
        code: 'D點',
        codeEn: 'Point D',
        name: '中央贊助商大道＆服務台 (i)',
        nameEn: 'Central Sponsor Row & Info (i)',
        stage: 'Sponsor & Bar',
        desc: '官方圖正中央一排贊助商攤位、酒吧與黃色 Info 服務台',
        descEn: 'Center row of Sponsor Activations, Bar & yellow Info booth',
        badgeColor: 'from-amber-500 to-orange-600',
        borderColor: 'border-amber-400',
        icon: '🍻',
        mapX: 49,
        mapY: 42,
        lat: 25.0752,
        lng: 121.5375,
        quickStatus: ['在中央吧台買酒', '逛贊助商攤位拍照']
      },
      {
        id: 'E',
        code: 'E點',
        codeEn: 'Point E',
        name: '東側 FOOD 美食區＆官方周邊店',
        nameEn: 'FOOD Alley & MERCH STORE',
        stage: 'Food & Merch',
        desc: 'RESISTANCE 左下方美食餐車、官方 Merch Store 與儲值站',
        descEn: 'Food zone, Merch Store & Cashless Top-Up near RESISTANCE',
        badgeColor: 'from-pink-500 to-rose-600',
        borderColor: 'border-pink-400',
        icon: '🍔',
        mapX: 71,
        mapY: 41,
        lat: 25.0753,
        lng: 121.5389,
        quickStatus: ['吃東西補體力', '排隊買周邊 / 儲值']
      },
      {
        id: 'F',
        code: 'F點',
        codeEn: 'Point F',
        name: 'GA/PGA/VIP 主入口＆置物櫃',
        nameEn: 'Main Entrance & Lockers',
        stage: 'Entrance & Lockers',
        desc: '官方圖右下側 GA/PGA/VIP ENTRANCE 主出入口、一排 Lockers 置物櫃與 Box Office',
        descEn: 'Bottom-right GA/PGA/VIP Entrance, Lockers & Box Office',
        badgeColor: 'from-slate-500 to-slate-700',
        borderColor: 'border-slate-400',
        icon: '🚕',
        mapX: 72,
        mapY: 57,
        lat: 25.0744,
        lng: 121.5390,
        quickStatus: ['剛過入口安檢', '在 Lockers 置物櫃集合']
      },
      {
        id: 'SOS',
        code: '🚑 求助',
        codeEn: '🚑 SOS',
        name: '緊急走失 / 醫護站 (+) / 需要支援',
        nameEn: 'Emergency / First Aid (+) / Help',
        stage: 'SOS',
        desc: '手機快沒電、不適需前往醫護站 (+) 或找不到隊友，點選後全員置頂警報！',
        descEn: 'Low battery, heading to First Aid (+), or lost!',
        badgeColor: 'from-red-600 to-rose-700',
        borderColor: 'border-red-500',
        icon: '🚨',
        mapX: 43,
        mapY: 46,
        lat: 25.0750,
        lng: 121.5371,
        quickStatus: ['手機快沒電了！', '在中央醫護站 (+) 休息']
      }
    ];

    // 時間字串轉分鐘 (支援跨午夜)
    const timeToMins = (hhmm) => {
      const [h, m] = hhmm.split(':').map(Number);
      return (h < 6 ? h + 24 : h) * 60 + m;
    };

    function App() {
      const [activeTab, setActiveTab] = useState('map'); // 'map' | 'friends' | 'timetable'
      const [lang, setLang] = useState('zh');
      const [nowTick, setNowTick] = useState(Date.now());

      // 個人身分狀態 (首次開啟自動引導輸入名字)
      const [myProfile, setMyProfile] = useState(() => {
        const saved = localStorage.getItem('ultra_tw_profile_v1');
        return saved ? JSON.parse(saved) : { name: '', partySize: 1 };
      });
      const [isEditingProfile, setIsEditingProfile] = useState(() => {
        return !localStorage.getItem('ultra_tw_profile_v1');
      });
      const [tempName, setTempName] = useState(myProfile.name || '');
      const [tempPartySize, setTempPartySize] = useState(myProfile.partySize || 1);

      // 定位清單 (預設完全乾淨為空陣列，絕無假人)
      const [checkins, setCheckins] = useState([]);
      const [selectedLandmark, setSelectedLandmark] = useState('A');
      const [watchingDj, setWatchingDj] = useState('');
      const [statusNote, setStatusNote] = useState('');
      const [activeMapPinId, setActiveMapPinId] = useState(null);
      const [mapPinMode, setMapPinMode] = useState(false);
      const [mapStyle, setMapStyle] = useState('illustrated'); // 'illustrated' (官方Sitemap重繪版) | 'hybrid' (官方Sitemap+衛星疊合) | 'satellite' (純衛星) | 'custom' (載入官方原圖)
      const [hybridOpacity, setHybridOpacity] = useState(0.68);
      const [customMapUrl, setCustomMapUrl] = useState(() => localStorage.getItem('ultra_tw_official_img') || '');
      const [toast, setToast] = useState(null);
      const [searchQuery, setSearchQuery] = useState('');
      const [cloudSyncStatus, setCloudSyncStatus] = useState('connecting');

      // 團長密碼重置保護 (連點標題 5 下開啟)
      const [adminTapCount, setAdminTapCount] = useState(0);
      const [showAdminModal, setShowAdminModal] = useState(false);
      const [adminPassword, setAdminPassword] = useState('');

      // 測試小工具：允許手動模擬現在時間，方便你們在週六之前先測試「NOW / NEXT 1 / NEXT 2」自動切換效果！
      const [simulatedTime, setSimulatedTime] = useState(''); // 空字串代表使用手機真實時間，例如 '19:40'

      useEffect(() => {
        const timer = setInterval(() => setNowTick(Date.now()), 20000);
        return () => clearInterval(timer);
      }, []);

      useEffect(() => {
        if (myProfile.name) {
          localStorage.setItem('ultra_tw_profile_v1', JSON.stringify(myProfile));
        }
      }, [myProfile]);

      // ==========================================
      // 🌐 跨手機雲端即時同步 (Firebase Realtime Database /ultra_tw_2026)
      // ==========================================
      const fetchCloudCheckins = async () => {
        try {
          const res = await fetch(`${FIREBASE_DB_URL}/${DB_NODE}/checkins.json`);
          if (!res.ok) throw new Error('Network error');
          const data = await res.json();
          if (data && typeof data === 'object') {
            const list = Object.values(data).filter(Boolean);
            setCheckins(list.sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0)));
          } else {
            setCheckins([]);
          }
          setCloudSyncStatus('live');
        } catch (err) {
          console.warn('Cloud sync fallback:', err);
          setCloudSyncStatus('offline');
        }
      };

      useEffect(() => {
        fetchCloudCheckins();
        let evtSource = null;
        try {
          evtSource = new EventSource(`${FIREBASE_DB_URL}/${DB_NODE}/checkins.json`);
          evtSource.addEventListener('put', fetchCloudCheckins);
          evtSource.addEventListener('patch', fetchCloudCheckins);
          evtSource.onerror = () => setCloudSyncStatus('offline');
        } catch (e) {}

        const pollTimer = setInterval(fetchCloudCheckins, 8000);
        return () => {
          if (evtSource) evtSource.close();
          clearInterval(pollTimer);
        };
      }, []);

      const t = (zh, en) => (lang === 'en' ? en : zh);
      const getLmCode = (lm) => (lang === 'en' ? (lm?.codeEn || lm?.code) : lm?.code);
      const getLmName = (lm) => (lang === 'en' ? (lm?.nameEn || lm?.name) : lm?.name);

      const showToast = (msg) => {
        setToast(msg);
        setTimeout(() => setToast(null), 3200);
      };

      const formatExactTime = (ts) => {
        if (!ts) return '--:--';
        return new Date(ts).toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false });
      };

      const formatTimeAgo = (ts) => {
        if (!ts) return t('剛剛', 'Just now');
        const mins = Math.max(0, Math.floor((nowTick - ts) / 60000));
        if (mins < 1) return t('剛剛', 'Just now');
        if (mins < 60) return t(`${mins}分前`, `${mins}m ago`);
        return t(`${Math.floor(mins / 60)}小時前`, `${Math.floor(mins / 60)}h ago`);
      };

      // ==========================================
      // ⏰ 計算當前舞台「NOW 正在演 + NEXT 1 + NEXT 2」3 個關鍵時段
      // ==========================================
      const getStageUpcomingSlots = (stageId) => {
        const list = ULTRA_TIMETABLE[stageId];
        if (!list) return [];

        const nowObj = new Date(nowTick);
        let curMins = nowObj.getHours() * 60 + nowObj.getMinutes();
        if (simulatedTime && /^\d{2}:\d{2}$/.test(simulatedTime)) {
          curMins = timeToMins(simulatedTime);
        } else if (nowObj.getHours() < 6) {
          curMins += 24 * 60;
        }

        // 找出目前正在表演，或接下來還沒結束的場次
        const activeOrUpcoming = list
          .map(slot => {
            const s = timeToMins(slot.start);
            const e = timeToMins(slot.end);
            const isNow = curMins >= s && curMins < e;
            return { ...slot, startMins: s, endMins: e, isNow };
          })
          .filter(slot => curMins < slot.endMins);

        // 如果活動還沒開始（例如早上 10 點打開測試），就顯示當天前 3 場；如果已過 22:00，顯示最後 3 場
        const picked = activeOrUpcoming.length > 0
          ? activeOrUpcoming.slice(0, 3)
          : curMins < timeToMins(list[0].start)
          ? list.slice(0, 3).map(s => ({ ...s, isNow: false }))
          : list.slice(-3).map(s => ({ ...s, isNow: false }));

        return picked.map((slot, idx) => ({
          ...slot,
          tag: slot.isNow ? 'NOW' : idx === 0 ? 'NEXT 1' : idx === 1 ? 'NEXT 2' : 'NEXT 3'
        }));
      };

      // 執行打卡定位
      const handleCheckIn = async (landmarkIdOverride, customCoords = null) => {
        if (!myProfile.name.trim()) {
          setIsEditingProfile(true);
          showToast(t('👋 請先輸入你的暱稱再打卡！', '👋 Please enter your name first!'));
          return;
        }

        const targetId = landmarkIdOverride || selectedLandmark;
        const lm = LANDMARKS.find(l => l.id === targetId) || LANDMARKS[0];
        const safeKey = `user_${myProfile.name.replace(/[.#$/\[\]\s]/g, '_')}`;

        const newEntry = {
          id: safeKey,
          name: myProfile.name,
          partySize: myProfile.partySize || 1,
          landmarkId: targetId,
          watchingDj: watchingDj.trim(),
          mapX: customCoords?.mapX ?? lm.mapX,
          mapY: customCoords?.mapY ?? lm.mapY,
          isCustomPin: Boolean(customCoords?.isCustomPin),
          lat: customCoords?.lat || lm.lat,
          lng: customCoords?.lng || lm.lng,
          note: statusNote.trim() || (watchingDj ? `🎧 正在看 ${watchingDj}` : t('剛抵達這邊！', 'Just arrived!')),
          updatedAt: Date.now()
        };

        setCheckins(prev => [newEntry, ...prev.filter(c => c.id !== safeKey && c.name !== myProfile.name)]);
        setActiveMapPinId(safeKey);
        setMapPinMode(false);
        setStatusNote('');
        showToast(t(`📍 已同步定位在【${lm.code} ${lm.name}】！`, `📍 Synced at [${lm.codeEn}]!`));

        try {
          await fetch(`${FIREBASE_DB_URL}/${DB_NODE}/checkins/${encodeURIComponent(safeKey)}.json`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newEntry)
          });
          setCloudSyncStatus('live');
        } catch (err) {
          setCloudSyncStatus('offline');
        }
      };

      // 團長密碼重置清空測試資料
      const handleAdminClearAll = async () => {
        if (adminPassword !== '2026') {
          showToast(t('❌ 密碼錯誤！', '❌ Wrong password!'));
          return;
        }
        setCheckins([]);
        setShowAdminModal(false);
        setAdminPassword('');
        try {
          await fetch(`${FIREBASE_DB_URL}/${DB_NODE}/checkins.json`, {
            method: 'DELETE'
          });
          showToast(t('🧹 已清空今日所有測試定位紀錄！', '🧹 Cleared all records!'));
        } catch (e) {}
      };

      // 手機真實 GPS 定位 (直接把真實經緯度換算到官方 Sitemap 精準座標上！)
      const handleGpsLocate = () => {
        if (!navigator.geolocation) {
          showToast(t('⚠️ 瀏覽器不支援 GPS', '⚠️ GPS not supported'));
          return;
        }
        showToast(t('🛰️ 正在取得手機 GPS 座標並對齊官方地圖...', '🛰️ Getting GPS coordinates...'));
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude, longitude } = pos.coords;
            let closest = LANDMARKS[0];
            let minD = Infinity;
            LANDMARKS.filter(l => l.id !== 'SOS').forEach(l => {
              const d = Math.hypot(l.lat - latitude, l.lng - longitude);
              if (d < minD) { minD = d; closest = l; }
            });

            // 判斷是否在大佳河濱公園園區範圍內，若在園區內則精準算出官方地圖上的真實位置
            const inPark =
              latitude <= SITEMAP_GEO_BOUNDS.north + 0.003 &&
              latitude >= SITEMAP_GEO_BOUNDS.south - 0.003 &&
              longitude >= SITEMAP_GEO_BOUNDS.west - 0.003 &&
              longitude <= SITEMAP_GEO_BOUNDS.east + 0.003;

            const mappedPos = inPark
              ? gpsToSitemapPercent(latitude, longitude)
              : { mapX: closest.mapX, mapY: closest.mapY };

            handleCheckIn(closest.id, {
              lat: Number(latitude.toFixed(6)),
              lng: Number(longitude.toFixed(6)),
              mapX: mappedPos.mapX,
              mapY: mappedPos.mapY,
              isCustomPin: inPark
            });
          },
          () => showToast(t('⚠️ 無法取得 GPS，請直接點選 A~F 點打卡', '⚠️ GPS denied, tap Point A~F')),
          { enableHighAccuracy: true, timeout: 8000 }
        );
      };

      // 點擊地圖任意處插旗
      const handleMapClick = (e) => {
        if (!mapPinMode) return;
        const rect = e.currentTarget.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        let nearest = LANDMARKS[0];
        let minD = Infinity;
        LANDMARKS.filter(l => l.id !== 'SOS').forEach(l => {
          const d = Math.hypot(l.mapX - x, l.mapY - y);
          if (d < minD) { minD = d; nearest = l; }
        });
        handleCheckIn(nearest.id, { mapX: x, mapY: y, isCustomPin: true });
      };

      // 一鍵複製 LINE 群組回報文字 (相容 iPhone/LINE 內建瀏覽器)
      const copyLineText = (mode = 'me') => {
        const timeStr = new Date().toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false });
        let text = '';
        if (mode === 'me') {
          const mine = checkins.find(c => c.name === myProfile.name) || checkins[0];
          const lm = LANDMARKS.find(l => l.id === (mine?.landmarkId || selectedLandmark));
          const djStr = mine?.watchingDj ? `\n🎧 正在看: ${mine.watchingDj}` : '';
          const sizeStr = (mine?.partySize || 1) > 1 ? ` (+${mine.partySize - 1}人)` : '';
          text = `⚡【Ultra Taiwan 定位 ${timeStr}】\n🙋‍♂️ ${myProfile.name || '我'}${sizeStr}\n📌 地點: ${lm.code} (${lm.name})${djStr}\n💬 備註: ${mine?.note || '在附近！'}\n🗺️ Google Maps: https://www.google.com/maps?q=${mine?.lat || lm.lat},${mine?.lng || lm.lng}`;
        } else {
          const lines = [`⚡【Ultra Taiwan 11/14 全團定位總整理 ${timeStr}】`];
          LANDMARKS.forEach(lm => {
